<Page
    x:Class="optimizerDuck.UI.Pages.LegacyRevertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:optimizerDuck.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:optimizerDuck.Domain.Optimizations.Models"
    xmlns:pages="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LegacyRevertsPage"
    d:DataContext="{d:DesignInstance pages:LegacyRevertsPage}"
    d:DesignHeight="650"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">
    <Grid>
        <Grid RowDefinitions="Auto,*" Visibility="{Binding ViewModel.HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!--  Compact Fluent header matching OptimizationPage card spacing  -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontTypography="Subtitle"
                        Text="{ext:Loc Optimizer.Legacy.Header}" />

                    <Border
                        Margin="10,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtlePillStyle}">
                        <ui:TextBlock
                            FontTypography="Caption"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding ViewModel.CountSummary}" />
                    </Border>
                </WrapPanel>

                <ui:TextBlock
                    Margin="0,4,0,0"
                    FontTypography="Body"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{ext:Loc Optimizer.Legacy.Description}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl Margin="0,0,4,0" ItemsSource="{Binding ViewModel.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LegacyRevertItem}">
                            <Border
                                Margin="0,0,0,10"
                                Padding="20,16"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusMedium}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <ui:TextBlock
                                            FontTypography="BodyStrong"
                                            Text="{Binding DisplayName}"
                                            TextWrapping="Wrap" />

                                        <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <Border Margin="0,0,6,4" Style="{StaticResource SubtlePillStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        Margin="0,0,4,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                        Symbol="History24" />
                                                    <ui:TextBlock
                                                        FontTypography="Caption"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding StepsSummary}" />
                                                </StackPanel>
                                            </Border>

                                            <Border Margin="0,0,0,4" Style="{StaticResource SubtlePillStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        Margin="0,0,4,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Symbol="Clock24" />
                                                    <ui:TextBlock
                                                        FontTypography="Caption"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding AppliedAtSummary}" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Width="34"
                                            Height="34"
                                            Margin="0,0,4,0"
                                            Padding="0"
                                            Command="{Binding DataContext.ViewModel.OpenRevertFileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Icon="{ui:SymbolIcon FolderOpen24}"
                                            Style="{StaticResource TransparentButtonStyle}"
                                            ToolTip="{ext:Loc Optimizer.Legacy.OpenFile.Tooltip}"
                                            ToolTipService.InitialShowDelay="150"
                                            ToolTipService.Placement="Top" />

                                        <ui:Button
                                            Width="34"
                                            Height="34"
                                            Margin="0,0,10,0"
                                            Padding="0"
                                            Command="{Binding DataContext.ViewModel.ClearRecordCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Icon="{ui:SymbolIcon Delete24}"
                                            IsEnabled="{Binding DataContext.ViewModel.IsNotBusy, RelativeSource={RelativeSource AncestorType=Page}}"
                                            Style="{StaticResource TransparentButtonStyle}"
                                            ToolTip="{ext:Loc Optimizer.Legacy.ClearRecord.Tooltip}"
                                            ToolTipService.InitialShowDelay="150"
                                            ToolTipService.Placement="Top" />

                                        <ui:Button
                                            Appearance="Secondary"
                                            Command="{Binding DataContext.ViewModel.RevertItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Content="{ext:Loc Optimizer.Legacy.Revert}"
                                            Cursor="Hand"
                                            Icon="{ui:SymbolIcon ArrowClockwise24}"
                                            IsEnabled="{Binding DataContext.ViewModel.IsNotBusy, RelativeSource={RelativeSource AncestorType=Page}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <controls:EmptyStateView
            Description="{ext:Loc Optimizer.Legacy.EmptyDescription}"
            Symbol="CheckmarkCircle24"
            Title="{ext:Loc Optimizer.Legacy.EmptyTitle}"
            Visibility="{Binding ViewModel.HasItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
    </Grid>
</Page>
