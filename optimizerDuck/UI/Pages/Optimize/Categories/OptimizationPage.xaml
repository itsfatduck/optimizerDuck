<Page
    x:Class="optimizerDuck.UI.Pages.Optimizations.OptimizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:optimizerDuck.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:optimization="clr-namespace:optimizerDuck.Domain.Optimizations.Models"
    xmlns:optimizations="clr-namespace:optimizerDuck.UI.Pages.Optimizations"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="OptimizationPage"
    d:DataContext="{d:DesignInstance optimizations:OptimizationPage}"
    d:DesignHeight="650"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">

    <Grid>
        <!--  Main Content  -->
        <Grid RowDefinitions="Auto,*" Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <!--  Toolbar  -->
            <Border Grid.Row="0" Style="{StaticResource ToolbarSurfaceStyle}">
                <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <!--  Search  -->
                    <ui:TextBox
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="{ext:Loc Common.Search.Placeholder}"
                        Style="{StaticResource SearchBoxStyle}"
                        Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Filter by Risk  -->
                    <ComboBox
                        SelectedIndex="{Binding ViewModel.SelectedRiskFilterIndex}"
                        ToolTip="{ext:Loc Common.Filter}"
                        ToolTipService.BetweenShowDelay="160"
                        ToolTipService.Placement="Top">
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Left"
                                    Symbol="Filter24" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Text="{ext:Loc Common.Filter.All}" />
                            </Grid>
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Symbol="ShieldCheckmark24" />
                                <TextBlock Grid.Column="1" Text="{ext:Loc Optimizer.UI.Risk.Safe}" />
                            </Grid>
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Symbol="Warning24" />
                                <TextBlock Grid.Column="1" Text="{ext:Loc Optimizer.UI.Risk.Moderate}" />
                            </Grid>
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Symbol="ShieldError24" />
                                <TextBlock Grid.Column="1" Text="{ext:Loc Optimizer.UI.Risk.Risky}" />
                            </Grid>
                        </ComboBoxItem>
                    </ComboBox>

                    <!--  Sort By  -->
                    <ComboBox
                        SelectedIndex="{Binding ViewModel.SelectedSortByIndex}"
                        ToolTip="{ext:Loc Common.SortBy}"
                        ToolTipService.BetweenShowDelay="160"
                        ToolTipService.Placement="Top">
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Left"
                                    Symbol="ArrowSort24" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Left">
                                    <Run Text="{ext:Loc Common.SortBy.RiskAndStatus}" />
                                </TextBlock>
                            </Grid>
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Left"
                                    Symbol="TextSortAscending24" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Text="{ext:Loc Common.SortBy.Name}" />
                            </Grid>
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Left"
                                    Symbol="Shield24" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Text="{ext:Loc Common.SortBy.Risk}" />
                            </Grid>
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Left"
                                    Symbol="ToggleRight24" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Text="{ext:Loc Common.SortBy.Status}" />
                            </Grid>
                        </ComboBoxItem>
                    </ComboBox>

                    <ui:ToggleSwitch
                        Margin="0,0,0,0"
                        VerticalAlignment="Stretch"
                        IsChecked="{Binding ViewModel.HideApplied}"
                        Visibility="{Binding ViewModel.HasAppliedOptimizations, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ext:Loc Optimizer.Menu.HideApplied}" />
                        </StackPanel>
                    </ui:ToggleSwitch>
                </WrapPanel>
            </Border>

            <!--  No search results  -->
            <controls:EmptyStateView
                Grid.Row="1"
                Description="{ext:Loc Bloatware.Search.NoResults}"
                Symbol="SearchInfo24"
                Visibility="{Binding ViewModel.Optimizations.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />

            <!--  Optimization Cards  -->
            <ui:VirtualizingItemsControl
                Grid.Row="1"
                ItemsSource="{Binding ViewModel.Optimizations}"
                VirtualizingPanel.CacheLength="1"
                VirtualizingPanel.CacheLengthUnit="Page"
                VirtualizingStackPanel.VirtualizationMode="Recycling"
                Visibility="{Binding ViewModel.Optimizations.Count, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}">
                <ui:VirtualizingItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                            <!--yeah -12 because <Setter Property="Margin" Value="0,0,12,12" /> -->
                            <ItemsPresenter Margin="0,0,-12,0" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ui:VirtualizingItemsControl.Template>
                <ui:VirtualizingItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid VerticalAlignment="Top" Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource WidthToColumnConverter}}" />
                    </ItemsPanelTemplate>
                </ui:VirtualizingItemsControl.ItemsPanel>
                <ui:VirtualizingItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                </ui:VirtualizingItemsControl.ItemContainerStyle>

                <ui:VirtualizingItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type optimization:BaseOptimization}">
                        <Border
                            Padding="20,16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusMedium}">
                            <Grid>
                                <!--  Unsupported compatibility state  -->
                                <Grid RowDefinitions="Auto,Auto,Auto,*" Visibility="{Binding IsConditionBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontSize="22"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Symbol="Warning24" />
                                        <ui:TextBlock
                                            VerticalAlignment="Center"
                                            FontTypography="Subtitle"
                                            Text="{ext:Loc Optimizer.Condition.BlockedTitle}" />
                                    </StackPanel>
                                    <ui:TextBlock
                                        Grid.Row="1"
                                        FontTypography="BodyStrong"
                                        Text="{Binding Name}"
                                        TextWrapping="Wrap" />

                                    <Border
                                        Grid.Row="2"
                                        Margin="0,10,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource CornerRadiusSmall}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                    Symbol="Warning24" />
                                                <ui:TextBlock
                                                    VerticalAlignment="Center"
                                                    FontTypography="Caption"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                    Text="{ext:Loc Optimizer.Condition.FailedTitle}" />
                                            </StackPanel>
                                            <ui:TextBlock
                                                Margin="0,6,0,0"
                                                FontTypography="BodyStrong"
                                                Text="{Binding ConditionResult.Title}"
                                                TextWrapping="Wrap" />
                                            <ui:TextBlock
                                                Margin="0,2,0,0"
                                                FontTypography="Body"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ConditionResult.Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel
                                        Grid.Row="3"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Bottom"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.ViewModel.HideConditionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Content="{ext:Loc Optimizer.Condition.Hide}"
                                            Cursor="Hand"
                                            ToolTip="{ext:Loc Optimizer.Condition.Hide.Tooltip}" />
                                        <Border
                                            Cursor="Help"
                                            ToolTip="{ext:Loc Optimizer.Condition.WhatIsThis.Tooltip}"
                                            ToolTipService.InitialShowDelay="150"
                                            ToolTipService.Placement="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0,0,4,0" Symbol="QuestionCircle24" />
                                                <ui:TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{ext:Loc Optimizer.Condition.WhatIsThis}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!--  Normal state  -->
                                <Grid RowDefinitions="Auto,Auto,Auto,*" Visibility="{Binding IsConditionBlocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <!--  Header: Title + capability/policy/restart indicators  -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <ui:TextBlock
                                            Grid.Column="0"
                                            FontTypography="Subtitle"
                                            Text="{Binding Name}"
                                            TextWrapping="Wrap" />

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="8,3,0,0"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="4,0,0,0"
                                                FontSize="14"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Symbol="Options24"
                                                ToolTip="{ext:Loc Optimizer.UI.Badge.Configurable}"
                                                ToolTipService.InitialShowDelay="150"
                                                ToolTipService.Placement="Top"
                                                Visibility="{Binding IsConfigurable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ui:SymbolIcon
                                                Margin="4,0,0,0"
                                                FontSize="14"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Symbol="ShieldLock24"
                                                ToolTip="{ext:Loc Optimizer.UI.Badge.GroupPolicy.Tooltip}"
                                                ToolTipService.InitialShowDelay="150"
                                                ToolTipService.Placement="Top"
                                                Visibility="{Binding SetsGroupPolicy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ui:SymbolIcon
                                                Margin="4,0,0,0"
                                                FontSize="14"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Symbol="ArrowSync24"
                                                ToolTip="{Binding RestartDisplay}"
                                                ToolTipService.InitialShowDelay="150"
                                                ToolTipService.Placement="Top"
                                                Visibility="{Binding HasRestartRequirement, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  Semantic impact chips (max 3)  -->
                                    <ItemsControl
                                        Grid.Row="1"
                                        Margin="0,6,0,0"
                                        ItemsSource="{Binding CardImpactDisplays}"
                                        Visibility="{Binding CardImpactDisplays.Count, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type optimization:OptimizationImpactDisplay}">
                                                <Border
                                                    Margin="0,0,4,4"
                                                    Padding="6,2"
                                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="{StaticResource CornerRadiusSmall}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon
                                                            Margin="0,0,4,0"
                                                            FontSize="12"
                                                            Symbol="{Binding Icon}">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTradeOff}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                        <ui:TextBlock
                                                            VerticalAlignment="Center"
                                                            FontTypography="Caption"
                                                            Text="{Binding Label}">
                                                            <ui:TextBlock.Style>
                                                                <Style TargetType="ui:TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTradeOff}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:TextBlock.Style>
                                                        </ui:TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ui:TextBlock
                                        Grid.Row="2"
                                        Margin="0,8,0,0"
                                        FontTypography="Body"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ShortDescription}"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="Wrap" />

                                    <!--  Footer: Risk/State pills on left, Toggle + Reconfigure + Details on right  -->
                                    <Grid
                                        Grid.Row="3"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Bottom"
                                        ColumnDefinitions="*,Auto">
                                        <Grid RowDefinitions="Auto,Auto">
                                            <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                <controls:RiskBadge Risk="{Binding Risk}" RiskVisual="{Binding RiskVisual}" />
                                                <controls:StateBadge
                                                    Margin="6,0,0,0"
                                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    Command="{Binding DataContext.ViewModel.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Icon="CheckmarkCircle24"
                                                    IconBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                                    Text="{ext:Loc Optimizer.UI.State.AlreadyOptimal}"
                                                    ToolTip="{ext:Loc Optimizer.UI.State.AlreadyOptimal.Tooltip}"
                                                    Visibility="{Binding State.IsAlreadyOptimal, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <controls:StateBadge
                                                    Margin="6,0,0,0"
                                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    Command="{Binding DataContext.ViewModel.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Icon="Warning24"
                                                    IconBrush="{DynamicResource SystemFillColorCautionBrush}"
                                                    Text="{ext:Loc Optimizer.UI.State.Drifted}"
                                                    ToolTip="{ext:Loc Optimizer.UI.State.Drifted.Tooltip}"
                                                    Visibility="{Binding State.IsDrifted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </WrapPanel>

                                            <controls:StateBadge
                                                Grid.Row="1"
                                                Margin="0,6,0,0"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                Command="{Binding DataContext.ViewModel.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="CheckmarkCircle24"
                                                IconBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                                Text="{Binding State.RelativeTime}"
                                                ToolTip="{Binding State.AppliedTooltip}"
                                                Visibility="{Binding State.IsApplied, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal">
                                            <ui:ToggleSwitch
                                                HorizontalAlignment="Right"
                                                Command="{Binding DataContext.ViewModel.ToggleOptimizationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                IsChecked="{Binding State.IsApplied, Mode=OneWay}"
                                                IsEnabled="{Binding DataContext.ViewModel.IsProcessing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}"
                                                Visibility="{Binding State.ShowToggle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ui:Button
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Command="{Binding DataContext.ViewModel.ReconfigureOptimizationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Icon="{ui:SymbolIcon Options24}"
                                                IsEnabled="{Binding DataContext.ViewModel.IsProcessing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}"
                                                Style="{StaticResource TransparentButtonStyle}"
                                                ToolTip="{ext:Loc Optimizer.Menu.Reconfigure}"
                                                Visibility="{Binding CanReconfigure, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ui:Button
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Command="{Binding DataContext.ViewModel.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Icon="{ui:SymbolIcon Info24}"
                                                Style="{StaticResource TransparentButtonStyle}"
                                                ToolTip="{ext:Loc Optimizer.Menu.Details}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ui:VirtualizingItemsControl.ItemTemplate>
            </ui:VirtualizingItemsControl>
        </Grid>

        <!--  Loading Indicator  -->
        <controls:LoadingStateOverlay
            IsLoading="{Binding ViewModel.IsLoading}"
            Subtitle="{ext:Loc Optimizations.Loading.Hint}"
            Title="{ext:Loc Optimizations.Loading}" />
    </Grid>
</Page>
