<Page
    x:Class="optimizerDuck.UI.Pages.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:optimizerDuck.UI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="OptimizerPage"
    d:DataContext="{d:DesignInstance pages:OptimizePage}"
    d:DesignHeight="650"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">
    <ui:NavigationView
        x:Name="RootNavigation"
        Margin="0"
        Padding="0"
        FrameMargin="0"
        IsBackButtonVisible="Collapsed"
        IsFooterSeparatorVisible="False"
        IsPaneToggleVisible="False"
        IsTopSeparatorVisible="False"
        behaviors:NavigationViewMenuItemsBehavior.ItemsSource="{Binding ViewModel.OptimizationCategories}"
        PaneDisplayMode="Top"
        Style="{StaticResource ScrollableTopNavigationViewStyle}" />
</Page>
