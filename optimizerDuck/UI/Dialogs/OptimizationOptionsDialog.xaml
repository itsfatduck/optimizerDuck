<UserControl
    x:Class="optimizerDuck.UI.Dialogs.OptimizationOptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogVm="clr-namespace:optimizerDuck.UI.ViewModels.Dialogs"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="500"
    MaxWidth="640"
    d:DataContext="{d:DesignInstance Type=dialogVm:OptimizationOptionsViewModel}"
    d:DesignHeight="480"
    d:DesignWidth="560"
    mc:Ignorable="d">
    <StackPanel>
        <ui:InfoBar
            Title="{ext:Loc OptimizationDetailsDialog.TradeOff}"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="True"
            Message="{Binding TradeOff}"
            Severity="Warning"
            Visibility="{Binding HasTradeOff, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ItemsControl ItemsSource="{Binding Options}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dialogVm:OptimizationOptionItemViewModel}">
                    <StackPanel>
                        <!--  Toggle option card  -->
                        <Border Style="{StaticResource CardSurfaceStyle}" Visibility="{Binding IsToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLockedAlreadySet}" Value="True">
                                                    <Setter Property="Opacity" Value="0.75" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <ui:TextBlock
                                        FontTypography="BodyStrong"
                                        Text="{Binding Label}"
                                        TextWrapping="Wrap" />
                                    <ui:TextBlock
                                        Margin="0,4,0,0"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Grid
                                        Margin="0,6,0,0"
                                        ColumnDefinitions="Auto,*"
                                        Visibility="{Binding ShowTradeOff, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ui:SymbolIcon
                                            Grid.Column="0"
                                            Margin="0,1,6,0"
                                            VerticalAlignment="Top"
                                            FontSize="14"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Symbol="Warning24" />
                                        <ui:TextBlock
                                            Grid.Column="1"
                                            FontTypography="Caption"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Text="{Binding TradeOff}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>

                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <ui:ToggleSwitch
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                        Visibility="{Binding IsInteractiveToggle, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Border
                                        Margin="12,0,0,0"
                                        Padding="8,4"
                                        VerticalAlignment="Center"
                                        Cursor="Help"
                                        Style="{StaticResource SubtlePillStyle}"
                                        ToolTip="{ext:Loc Optimizer.Options.AlreadySet.Tooltip}"
                                        ToolTipService.InitialShowDelay="150"
                                        ToolTipService.Placement="Top"
                                        Visibility="{Binding IsLockedAlreadySet, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                FontSize="14"
                                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                Symbol="CheckmarkCircle24" />
                                            <ui:TextBlock
                                                VerticalAlignment="Center"
                                                FontTypography="Caption"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                Text="{ext:Loc Optimizer.Options.AlreadySet}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!--  Single-choice option group  -->
                        <Border Style="{StaticResource CardSurfaceStyle}" Visibility="{Binding IsSingleChoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <ui:TextBlock
                                    Margin="0,0,0,8"
                                    FontTypography="BodyStrong"
                                    Text="{Binding Label}"
                                    TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{Binding Choices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dialogVm:OptimizationOptionChoiceViewModel}">
                                            <Border
                                                Margin="0,0,0,6"
                                                Padding="10,8"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="{StaticResource CornerRadiusSmall}">
                                                <RadioButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand"
                                                    GroupName="{Binding DataContext.GroupName, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <StackPanel Margin="4,0,0,0">
                                                        <ui:TextBlock
                                                            FontTypography="BodyStrong"
                                                            Text="{Binding Label}"
                                                            TextWrapping="Wrap" />
                                                        <ui:TextBlock
                                                            Margin="0,2,0,0"
                                                            FontTypography="Caption"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Description}"
                                                            TextWrapping="Wrap"
                                                            Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border
            Margin="0,4,0,0"
            Padding="10,8"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="{StaticResource CornerRadiusSmall}"
            Visibility="{Binding ShowAllAlreadySetHint, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid ColumnDefinitions="Auto,*">
                <ui:SymbolIcon
                    Grid.Column="0"
                    Margin="0,1,8,0"
                    VerticalAlignment="Top"
                    FontSize="14"
                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                    Symbol="CheckmarkCircle24" />
                <ui:TextBlock
                    Grid.Column="1"
                    FontTypography="Caption"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{ext:Loc Optimizer.Options.AllAlreadySet}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border
            Margin="0,4,0,0"
            Padding="10,8"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="{StaticResource CornerRadiusSmall}"
            Visibility="{Binding ShowSelectAtLeastOneHint, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid ColumnDefinitions="Auto,*">
                <ui:SymbolIcon
                    Grid.Column="0"
                    Margin="0,1,8,0"
                    VerticalAlignment="Top"
                    FontSize="14"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Warning24" />
                <ui:TextBlock
                    Grid.Column="1"
                    FontTypography="Caption"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="{ext:Loc Optimizer.Options.SelectAtLeastOne}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border
            Margin="0,4,0,0"
            Padding="10,8"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="{StaticResource CornerRadiusSmall}"
            Visibility="{Binding ShowWillRevertHint, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid ColumnDefinitions="Auto,*">
                <ui:SymbolIcon
                    Grid.Column="0"
                    Margin="0,1,8,0"
                    VerticalAlignment="Top"
                    FontSize="14"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="ArrowClockwise24" />
                <ui:TextBlock
                    Grid.Column="1"
                    FontTypography="Caption"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="{ext:Loc Optimizer.Options.AllOffWillRevert}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
