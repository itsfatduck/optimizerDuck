<UserControl
    x:Class="optimizerDuck.UI.Dialogs.OptimizationDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:optimizerDuck.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogVm="clr-namespace:optimizerDuck.UI.ViewModels.Dialogs"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=dialogVm:OptimizationDetailsViewModel}"
    d:DesignHeight="760"
    d:DesignWidth="760"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!-- One fact of a record: a chip with its own icon, label and value. -->
        <DataTemplate x:Key="RecordFieldChip">
            <Border
                Margin="0,0,6,6"
                Padding="6,2"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="{StaticResource CornerRadiusSmall}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,6,0"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="{Binding Icon}" />
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Label}" />
                    <ui:TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Text="{Binding Value}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <Border
            Margin="0,0,0,12"
            Padding="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusMedium}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                <ui:TextBlock
                    Appearance="Disabled"
                    FontTypography="Caption"
                    Text="{Binding Optimization.Id}" />

                <ui:TextBlock
                    Grid.Row="1"
                    Margin="0,2,0,0"
                    FontTypography="Subtitle"
                    Text="{Binding Optimization.Name}"
                    TextWrapping="Wrap" />

                <ui:VirtualizingItemsControl
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    ItemsSource="{Binding Optimization.TagDisplays}">
                    <ui:VirtualizingItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ui:VirtualizingItemsControl.ItemsPanel>
                    <ui:VirtualizingItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,6,6" />
                        </Style>
                    </ui:VirtualizingItemsControl.ItemContainerStyle>
                    <ui:VirtualizingItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Style="{StaticResource SubtlePillStyle}"
                                ToolTip="{Binding Description}"
                                ToolTipService.InitialShowDelay="150"
                                ToolTipService.Placement="Top">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,6,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="{Binding Icon}" />
                                    <ui:TextBlock
                                        VerticalAlignment="Center"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Display}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ui:VirtualizingItemsControl.ItemTemplate>
                </ui:VirtualizingItemsControl>

                <Grid
                    Grid.Row="3"
                    Margin="0,4,0,0"
                    ColumnDefinitions="Auto,Auto,*">
                    <controls:RiskBadge Risk="{Binding Optimization.Risk}" RiskVisual="{Binding Optimization.RiskVisual}" />

                    <Border
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="6,4"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource CornerRadiusSmall}"
                        ToolTip="{Binding Optimization.State.AppliedAt}"
                        ToolTipService.InitialShowDelay="150"
                        ToolTipService.Placement="Top"
                        Visibility="{Binding Optimization.State.AppliedAt, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,6,0" Symbol="CheckmarkCircle24" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontTypography="Caption"
                                Text="{Binding Optimization.State.RelativeTime}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="6,4"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource CornerRadiusSmall}"
                        Visibility="{Binding RecordIsRevert, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,6,0" Symbol="ArrowClockwise24" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontTypography="Caption"
                                Text="{Binding RecordHeadline}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border
            Margin="0,0,0,12"
            Padding="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusMedium}">
            <StackPanel>
                <ui:TextBlock
                    Margin="0,0,0,8"
                    FontTypography="BodyStrong"
                    Text="{ext:Loc OptimizationDetailsDialog.DetailedDescription}" />
                <ui:TextBlock
                    FontTypography="Body"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Optimization.ShortDescription}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ui:TextBlock
            Margin="0,0,0,8"
            FontTypography="BodyStrong"
            Text="{ext:Loc OptimizationDetailsDialog.TechnicalDetails}" />

        <Border
            Margin="0,0,0,12"
            Padding="0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusMedium}">
            <StackPanel>
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{ext:Loc OptimizationDetailsDialog.Id}" />
                    <ui:TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Text="{Binding Optimization.Id}"
                        TextWrapping="Wrap" />
                </Grid>
                <Separator Margin="16,0" />
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{ext:Loc OptimizationDetailsDialog.Class}" />
                    <ui:TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Text="{Binding Optimization.OptimizationKey}"
                        TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>


        <ui:TextBlock
            Margin="0,0,0,8"
            FontTypography="BodyStrong"
            Text="{ext:Loc Optimizer.Details.Record.Title}" />

        <Border
            Margin="0,0,0,12"
            Padding="0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusMedium}">
            <StackPanel>
                <ui:TextBlock
                    Margin="16,16,16,0"
                    FontTypography="BodyStrong"
                    Text="{Binding RecordHeadline}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasRecord, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ItemsControl
                    Margin="16,8,16,0"
                    ItemTemplate="{StaticResource RecordFieldChip}"
                    ItemsSource="{Binding RecordFacts}"
                    Visibility="{Binding HasRecordFacts, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Left" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ui:TextBlock
                    Margin="16"
                    Appearance="Disabled"
                    FontTypography="Body"
                    Text="{ext:Loc Optimizer.Details.Record.Empty}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasRecord, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                <ItemsControl ItemsSource="{Binding Steps}" Visibility="{Binding HasRecord, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="16,10"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <ui:SymbolIcon
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Top"
                                        Symbol="{Binding Icon}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Skip">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="NotApplicable">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Refused">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Irreversible">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                    <!--  last, so a failed step is red whatever its kind says  -->
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock
                                                FontTypography="Caption"
                                                FontWeight="SemiBold"
                                                Text="{Binding KindLabel}" />
                                            <ui:TextBlock
                                                Margin="6,0,0,0"
                                                Appearance="Disabled"
                                                FontTypography="Caption"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:TextBlock
                                            Margin="0,2,0,0"
                                            FontTypography="Body"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding ShowDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <ui:TextBlock
                                            Margin="0,2,0,0"
                                            FontTypography="Body"
                                            Text="{Binding OperationLabel}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding HasOperation, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <ItemsControl
                                            Margin="0,6,0,0"
                                            ItemTemplate="{StaticResource RecordFieldChip}"
                                            ItemsSource="{Binding Fields}"
                                            Visibility="{Binding HasFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel HorizontalAlignment="Left" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <ui:TextBlock
                                            Margin="0,2,0,0"
                                            FontTypography="Caption"
                                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                            Text="{Binding Detail}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <ui:TextBlock
            Margin="0,0,0,8"
            FontTypography="BodyStrong"
            Text="{ext:Loc OptimizationDetailsDialog.Other}" />

        <ui:CardAction
            Margin="0,0,0,4"
            Command="{Binding ViewSourceOnGitHubCommand}"
            Cursor="Hand"
            Icon="{ui:SymbolIcon Code24}">
            <StackPanel>
                <ui:TextBlock
                    FontTypography="BodyStrong"
                    Text="{ext:Loc OptimizationDetailsDialog.Other.ViewSource.Title}"
                    TextWrapping="Wrap" />
                <ui:TextBlock
                    FontTypography="Body"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{ext:Loc OptimizationDetailsDialog.Other.ViewSource.Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ui:CardAction>

        <ui:CardAction
            Margin="0,0,0,4"
            Command="{Binding OpenRecordFileCommand}"
            Icon="{ui:SymbolIcon History24}"
            Visibility="{Binding HasRecord, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <ui:TextBlock
                    FontTypography="BodyStrong"
                    Text="{ext:Loc OptimizationDetailsDialog.Other.OpenRecordFile.Title}"
                    TextWrapping="Wrap" />
                <ui:TextBlock
                    FontTypography="Body"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{ext:Loc OptimizationDetailsDialog.Other.OpenRecordFile.Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ui:CardAction>

        <ui:CardAction
            Margin="0,0,0,4"
            Command="{Binding OpenRevertFileCommand}"
            Icon="{ui:SymbolIcon FolderOpen24}"
            Visibility="{Binding Optimization.State.AppliedAt, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel>
                <ui:TextBlock
                    FontTypography="BodyStrong"
                    Text="{ext:Loc OptimizationDetailsDialog.Other.OpenRevertFile.Title}"
                    TextWrapping="Wrap" />
                <ui:TextBlock
                    FontTypography="Body"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{ext:Loc OptimizationDetailsDialog.Other.OpenRevertFile.Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ui:CardAction>
    </StackPanel>
</UserControl>
