<UserControl
    x:Class="optimizerDuck.UI.Dialogs.OptimizationDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:optimizerDuck.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogVm="clr-namespace:optimizerDuck.UI.ViewModels.Dialogs"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:optimizerDuck.Domain.Optimizations.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=dialogVm:OptimizationDetailsViewModel}"
    d:DesignHeight="820"
    d:DesignWidth="760"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  One fact of a record: a chip with its own icon, label and value.  -->
        <DataTemplate x:Key="RecordFieldChip">
            <Border
                Margin="0,0,6,6"
                Padding="6,2"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="{StaticResource CornerRadiusSmall}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,6,0"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="{Binding Icon}" />
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Label}" />
                    <ui:TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Text="{Binding Value}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <!--  Header summary card  -->
        <Border
            Margin="0,0,0,12"
            Padding="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusMedium}">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <ui:TextBlock
                    FontTypography="Subtitle"
                    Text="{Binding Optimization.Name}"
                    TextWrapping="Wrap" />

                <ItemsControl
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    ItemsSource="{Binding TagDisplays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,6,6"
                                Style="{StaticResource SubtlePillStyle}"
                                ToolTip="{Binding Description}"
                                ToolTipService.InitialShowDelay="150"
                                ToolTipService.Placement="Top">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,6,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="{Binding Icon}" />
                                    <ui:TextBlock
                                        VerticalAlignment="Center"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Display}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <WrapPanel Grid.Row="2" Margin="0,4,0,0" Orientation="Horizontal">
                    <controls:RiskBadge
                        Margin="0,0,6,6"
                        Risk="{Binding Optimization.Risk}"
                        RiskVisual="{Binding Optimization.RiskVisual}" />

                    <!--  Applied timestamp chip  -->
                    <Border
                        Margin="0,0,6,6"
                        Padding="6,2"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource CornerRadiusSmall}"
                        ToolTip="{Binding Optimization.State.AppliedAt}"
                        Visibility="{Binding IsAppliedState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                Symbol="CheckmarkCircle24" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontTypography="Caption"
                                Text="{Binding Optimization.State.RelativeTime}" />
                        </StackPanel>
                    </Border>

                    <!--  Already optimal chip  -->
                    <Border
                        Margin="0,0,6,6"
                        Padding="6,2"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource CornerRadiusSmall}"
                        Visibility="{Binding IsAlreadyOptimal, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                Symbol="CheckmarkCircle24" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontTypography="Caption"
                                Text="{ext:Loc Optimizer.UI.State.AlreadyOptimal}" />
                        </StackPanel>
                    </Border>

                    <!--  Drifted chip  -->
                    <Border
                        Margin="0,0,6,6"
                        Padding="6,2"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource CornerRadiusSmall}"
                        Visibility="{Binding IsDrifted, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Symbol="Warning24" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontTypography="Caption"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Text="{ext:Loc Optimizer.UI.State.Drifted}" />
                        </StackPanel>
                    </Border>

                    <!--  Restart requirement chip  -->
                    <Border
                        Margin="0,0,6,6"
                        Padding="6,2"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource CornerRadiusSmall}"
                        Visibility="{Binding HasRestartRequirement, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="ArrowSync24" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontTypography="Caption"
                                Text="{Binding RestartDisplay}" />
                        </StackPanel>
                    </Border>

                    <!--  Group Policy chip  -->
                    <Border
                        Margin="0,0,6,6"
                        Padding="6,2"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource CornerRadiusSmall}"
                        Visibility="{Binding SetsGroupPolicy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="ShieldLock24" />
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontTypography="Caption"
                                Text="{ext:Loc Optimizer.UI.Badge.GroupPolicy}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!--  Drifted state resolution card  -->
        <Border
            Margin="0,0,0,12"
            Padding="14"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusMedium}"
            Visibility="{Binding IsDrifted, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Symbol="Warning24" />
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontTypography="BodyStrong"
                        Text="{ext:Loc OptimizationDetailsDialog.DriftedTitle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ui:TextBlock
                    Margin="0,6,0,10"
                    FontTypography="Body"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{ext:Loc OptimizationDetailsDialog.DriftedMessage}"
                    TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding RequestRevertRemainingCommand}"
                        Content="{ext:Loc OptimizationDetailsDialog.RevertRemaining}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                    <ui:Button
                        Command="{Binding RequestClearStaleRevertCommand}"
                        Content="{ext:Loc OptimizationDetailsDialog.ClearStale}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon Delete24}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!--  Explicit trade-off warning  -->
        <ui:InfoBar
            Title="{ext:Loc OptimizationDetailsDialog.TradeOff}"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="True"
            Message="{Binding TradeOff}"
            Severity="Warning"
            Visibility="{Binding HasTradeOff, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!--  Overview & Impacts  -->
        <Border
            Margin="0,0,0,12"
            Padding="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusMedium}">
            <StackPanel>
                <ui:TextBlock
                    Margin="0,0,0,8"
                    FontTypography="BodyStrong"
                    Text="{ext:Loc OptimizationDetailsDialog.DetailedDescription}" />
                <ui:TextBlock
                    FontTypography="Body"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding DetailedDescription}"
                    TextWrapping="Wrap" />

                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasImpacts, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock
                        Margin="0,0,0,6"
                        FontTypography="Caption"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{ext:Loc OptimizationDetailsDialog.Impacts}" />
                    <ItemsControl ItemsSource="{Binding ImpactDisplays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Left" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:OptimizationImpactDisplay}">
                                <Border
                                    Margin="0,0,6,6"
                                    Padding="6,2"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource CornerRadiusSmall}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,0,4,0"
                                            FontSize="13"
                                            Symbol="{Binding Icon}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTradeOff}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <ui:TextBlock
                                            VerticalAlignment="Center"
                                            FontTypography="Caption"
                                            Text="{Binding Label}">
                                            <ui:TextBlock.Style>
                                                <Style TargetType="ui:TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTradeOff}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:TextBlock.Style>
                                        </ui:TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ui:TextBlock
                    Margin="0,8,0,0"
                    FontTypography="Caption"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{ext:Loc OptimizationDetailsDialog.GroupPolicyNotice}"
                    TextWrapping="Wrap"
                    Visibility="{Binding SetsGroupPolicy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <!--  Selected Options (when configurable optimization has active applied choices)  -->
        <Border
            Margin="0,0,0,12"
            Padding="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusMedium}"
            Visibility="{Binding HasSelectedOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Border
                            Width="28"
                            Height="28"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="6">
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                                Symbol="Options24" />
                        </Border>
                        <ui:TextBlock
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Text="{ext:Loc OptimizationDetailsDialog.SelectedOptions}" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="1"
                        Appearance="Secondary"
                        Command="{Binding RequestReconfigureCommand}"
                        Content="{ext:Loc OptimizationDetailsDialog.Reconfigure}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon Options24}"
                        Visibility="{Binding CanReconfigure, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding SelectedOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dialogVm:SelectedOptionDisplay}">
                            <Border
                                Margin="0,0,0,6"
                                Padding="12,10"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusSmall}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <ui:SymbolIcon
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Symbol="{Binding Icon}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Filled" Value="True" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static dialogVm:SelectedOptionState.Choice}">
                                                        <Setter Property="Filled" Value="True" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static dialogVm:SelectedOptionState.Disabled}">
                                                        <Setter Property="Filled" Value="False" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>

                                    <ui:TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontTypography="Body"
                                        Text="{Binding Label}"
                                        TextWrapping="Wrap">
                                        <ui:TextBlock.Style>
                                            <Style TargetType="ui:TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static dialogVm:SelectedOptionState.Disabled}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>

                                    <Border
                                        Grid.Column="2"
                                        Margin="12,0,0,0"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CornerRadiusSmall}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse
                                                Width="6"
                                                Height="6"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static dialogVm:SelectedOptionState.Choice}">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static dialogVm:SelectedOptionState.Disabled}">
                                                                <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <ui:TextBlock
                                                VerticalAlignment="Center"
                                                FontTypography="Caption"
                                                Text="{Binding Value}">
                                                <ui:TextBlock.Style>
                                                    <Style TargetType="ui:TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static dialogVm:SelectedOptionState.Choice}">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static dialogVm:SelectedOptionState.Disabled}">
                                                                <Setter Property="FontWeight" Value="Normal" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:TextBlock.Style>
                                            </ui:TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--  Verifiable Sources  -->
        <StackPanel Margin="0,0,0,12" Visibility="{Binding HasSources, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:TextBlock
                Margin="0,0,0,8"
                FontTypography="BodyStrong"
                Text="{ext:Loc OptimizationDetailsDialog.Sources}" />
            <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:OptimizationSource}">
                        <ui:CardAction
                            Margin="0,0,0,4"
                            Command="{Binding DataContext.OpenSourceUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Url}"
                            Cursor="Hand"
                            IsChevronVisible="False">
                            <ui:CardAction.Icon>
                                <ui:SymbolIcon FontSize="24" Symbol="{Binding Icon}" />
                            </ui:CardAction.Icon>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <ui:TextBlock
                                        FontTypography="BodyStrong"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Host}" />
                                </StackPanel>
                                <ui:SymbolIcon
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Symbol="Open24" />
                            </Grid>
                        </ui:CardAction>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--  Last Run Change Record  -->
        <ui:TextBlock
            Margin="0,0,0,8"
            FontTypography="BodyStrong"
            Text="{ext:Loc Optimizer.Details.Record.Title}" />

        <Border
            Margin="0,0,0,12"
            Padding="0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusMedium}">
            <StackPanel>
                <ui:TextBlock
                    Margin="16,16,16,0"
                    FontTypography="BodyStrong"
                    Text="{Binding RecordHeadline}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasRecord, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ItemsControl
                    Margin="16,8,16,0"
                    ItemTemplate="{StaticResource RecordFieldChip}"
                    ItemsSource="{Binding RecordFacts}"
                    Visibility="{Binding HasRecordFacts, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Left" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ui:TextBlock
                    Margin="16"
                    Appearance="Disabled"
                    FontTypography="Body"
                    Text="{ext:Loc Optimizer.Details.Record.Empty}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasRecord, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                <ItemsControl ItemsSource="{Binding Steps}" Visibility="{Binding HasRecord, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="16,10"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <ui:SymbolIcon
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Top"
                                        Symbol="{Binding Icon}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Skip">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="NotApplicable">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Refused">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Irreversible">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                    <!--  last, so a failed step is red whatever its kind says  -->
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock
                                                FontTypography="Caption"
                                                FontWeight="SemiBold"
                                                Text="{Binding KindLabel}" />
                                            <ui:TextBlock
                                                Margin="6,0,0,0"
                                                Appearance="Disabled"
                                                FontTypography="Caption"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:TextBlock
                                            Margin="0,2,0,0"
                                            FontTypography="Body"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding ShowDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <ui:TextBlock
                                            Margin="0,2,0,0"
                                            FontTypography="Body"
                                            Text="{Binding OperationLabel}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding HasOperation, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <ItemsControl
                                            Margin="0,6,0,0"
                                            ItemTemplate="{StaticResource RecordFieldChip}"
                                            ItemsSource="{Binding Fields}"
                                            Visibility="{Binding HasFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel HorizontalAlignment="Left" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <ui:TextBlock
                                            Margin="0,2,0,0"
                                            FontTypography="Caption"
                                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                            Text="{Binding Detail}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--  Technical Details  -->
        <ui:TextBlock
            Margin="0,0,0,8"
            FontTypography="BodyStrong"
            Text="{ext:Loc OptimizationDetailsDialog.TechnicalDetails}" />

        <Border
            Margin="0,0,0,12"
            Padding="0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusMedium}">
            <StackPanel>
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{ext:Loc OptimizationDetailsDialog.Id}" />
                    <ui:TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Text="{Binding Optimization.Id}"
                        TextWrapping="Wrap" />
                </Grid>
                <Separator Margin="16,0" />
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{ext:Loc OptimizationDetailsDialog.Class}" />
                    <ui:TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Text="{Binding Optimization.OptimizationKey}"
                        TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>

        <!--  Other Actions  -->
        <ui:TextBlock
            Margin="0,0,0,8"
            FontTypography="BodyStrong"
            Text="{ext:Loc OptimizationDetailsDialog.Other}" />

        <ui:CardAction
            Margin="0,0,0,4"
            Command="{Binding ViewSourceOnGitHubCommand}"
            Cursor="Hand"
            Icon="{ui:SymbolIcon Code24}">
            <StackPanel>
                <ui:TextBlock
                    FontTypography="BodyStrong"
                    Text="{ext:Loc OptimizationDetailsDialog.Other.ViewSource.Title}"
                    TextWrapping="Wrap" />
                <ui:TextBlock
                    FontTypography="Body"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{ext:Loc OptimizationDetailsDialog.Other.ViewSource.Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ui:CardAction>

        <ui:CardAction
            Margin="0,0,0,4"
            Command="{Binding OpenRecordFileCommand}"
            Cursor="Hand"
            Icon="{ui:SymbolIcon History24}"
            Visibility="{Binding HasRecord, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <ui:TextBlock
                    FontTypography="BodyStrong"
                    Text="{ext:Loc OptimizationDetailsDialog.Other.OpenRecordFile.Title}"
                    TextWrapping="Wrap" />
                <ui:TextBlock
                    FontTypography="Body"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{ext:Loc OptimizationDetailsDialog.Other.OpenRecordFile.Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ui:CardAction>

        <ui:CardAction
            Margin="0,0,0,4"
            Command="{Binding OpenRevertFileCommand}"
            Cursor="Hand"
            Icon="{ui:SymbolIcon FolderOpen24}"
            Visibility="{Binding ShowRevertFileAction, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <ui:TextBlock
                    FontTypography="BodyStrong"
                    Text="{ext:Loc OptimizationDetailsDialog.Other.OpenRevertFile.Title}"
                    TextWrapping="Wrap" />
                <ui:TextBlock
                    FontTypography="Body"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{ext:Loc OptimizationDetailsDialog.Other.OpenRevertFile.Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ui:CardAction>
    </StackPanel>
</UserControl>
