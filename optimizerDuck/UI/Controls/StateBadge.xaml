<UserControl
    x:Class="optimizerDuck.UI.Controls.StateBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="BadgeRoot"
    HorizontalAlignment="Left"
    VerticalAlignment="Center">
    <!-- A border, not a button: the chip keeps exactly the card's own look, and only the mouse
         behaviour is added on top of it. -->
    <Border
        Cursor="Hand"
        MouseLeave="OnMouseLeave"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Background" Value="{Binding Background, ElementName=BadgeRoot}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsPressed, ElementName=BadgeRoot}" Value="True">
                        <Setter Property="Opacity" Value="0.85" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon
                Margin="0,0,6,0"
                FontSize="14"
                Symbol="{Binding Icon, ElementName=BadgeRoot}">
                <ui:SymbolIcon.Style>
                    <Style TargetType="ui:SymbolIcon">
                        <Setter Property="Foreground" Value="{Binding IconBrush, ElementName=BadgeRoot}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IconBrush, ElementName=BadgeRoot}" Value="{x:Null}">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <ui:TextBlock
                VerticalAlignment="Center"
                FontTypography="Caption"
                Text="{Binding Text, ElementName=BadgeRoot}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
